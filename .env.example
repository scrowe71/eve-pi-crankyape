# Set these in Cloudflare Pages -> Settings -> Variables and Secrets
# (for local `npx wrangler pages dev out`, put them in a .dev.vars file).
# Create the EVE app at https://developers.eveonline.com/
EVE_SSO_CLIENT_ID=Client ID
EVE_SSO_SECRET=Secret Key (add as an encrypted secret)
EVE_SSO_CALLBACK_URL=https://pi.crankyape.space
# Optional: override the appraisal service used for PI prices
# PRAISAL_URL=https://praisal.avanto.tk/appraisal/structured.json?persist=no
